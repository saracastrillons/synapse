# Copy to .env (never commit it). Defaults work for local development.
DATABASE_URL=sqlite:///./synapse.db
# DATABASE_URL=postgresql+psycopg://synapse:synapse@localhost:5432/synapse
# REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:5191
# LLM copilot (optional). Without a key the app uses the on-device planner.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
